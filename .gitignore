# Dependencies
node_modules/

# Environment files: real secrets never get committed.
# .env.example IS committed, so the variable names are documented.
.env
.env.local

# React production build (generated by `npm run build`, not source)
client/dist/
client/build/

# Logs and editor/OS noise
*.log
npm-debug.log*
.DS_Store
.vscode/

# Vite dev-server cache
client/node_modules/
client/.vite/
