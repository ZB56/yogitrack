# Copy this file to .env and fill in real values. .env is git-ignored.
# Java analogy: this is like a properties file read at startup.

# Port the Express server listens on in development.
# Heroku supplies its own PORT in production, which overrides this.
PORT=5001

# MongoDB connection string.
# Local development (MongoDB Community running on this machine):
MONGODB_URI=mongodb://127.0.0.1:27017/yogitrack
# MongoDB Atlas (production) looks like:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/yogitrack?retryWrites=true&w=majority
