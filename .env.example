# Copy this file to .env and fill in real values. .env is git-ignored.
# Java analogy: this is like a properties file read at startup.

# Port the Express server listens on in development.
# Heroku supplies its own PORT in production, which overrides this.
PORT=5001

# MongoDB connection string.
# Local development (MongoDB Community running on this machine):
MONGODB_URI=mongodb://127.0.0.1:27017/yogitrack
# MongoDB Atlas (production) looks like:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/yogitrack?retryWrites=true&w=majority

# Secret used to sign the JSON Web Tokens that keep a user signed in
# (Part 2 authentication). Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production this MUST be set, and the server refuses to start without it.
# In development, leaving it unset makes the server generate a throwaway
# secret at startup, so every restart signs everyone out.
JWT_SECRET=

# Only read by `npm run create:manager`, which creates the first manager
# login. Pass them on the command line rather than storing them here:
#   MANAGER_USERNAME=studio MANAGER_PASSWORD='choose-a-long-one' npm run create:manager
# MANAGER_USERNAME=
# MANAGER_PASSWORD=
